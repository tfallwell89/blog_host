// Prisma schema for the hosted food-blog platform.
//
// Multi-tenancy is modelled at the Blog level: every piece of published
// content hangs off a Blog, and access is granted through BlogMember.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogRole {
  OWNER
  EDITOR
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
}

enum RecipeDifficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String
  // Seam for the email-verification flow; null means "not verified yet".
  emailVerifiedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions    Session[]
  memberships BlogMember[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  // Only the SHA-256 hash of the session token is stored.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Blog {
  id          String   @id @default(cuid())
  name        String
  subdomain   String   @unique
  description String
  authorName  String
  /// External http(s) image URL, like recipe photos. Null means "show the blog name".
  logoUrl     String?
  /// The one colour a blog owner controls, stored as an uppercase #RRGGBB hex.
  brandColor  String   @default("#FF4F5A")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members BlogMember[]
  recipes Recipe[]
  groups  Group[]

  @@map("blogs")
}

/// Join table between users and blogs. A user may hold membership in several
/// blogs even though the MVP onboarding only creates one.
model BlogMember {
  id        String   @id @default(cuid())
  blogId    String
  userId    String
  role      BlogRole @default(OWNER)
  createdAt DateTime @default(now())

  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([blogId, userId])
  @@index([userId])
  @@map("blog_members")
}

model Recipe {
  id                String            @id @default(cuid())
  blogId            String
  title             String
  slug              String
  description       String
  introduction      String?
  storyTitle        String?
  storyBody         String?
  storyImageUrl     String?
  featuredImageUrl  String?
  prepMinutes       Int?
  cookMinutes       Int?
  additionalMinutes Int?
  servings          Int?
  cuisine           String?
  course            String?
  difficulty        RecipeDifficulty?
  notes             String?
  status            RecipeStatus      @default(DRAFT)
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  blog              Blog               @relation(fields: [blogId], references: [id], onDelete: Cascade)
  ingredientGroups  IngredientGroup[]
  instructionGroups InstructionGroup[]
  groups            GroupedRecipe[]

  @@unique([blogId, slug])
  @@index([blogId, status, publishedAt])
  @@index([blogId, updatedAt])
  @@map("recipes")
}

/// A named set of related recipes owned by one blog, e.g. "Weeknight dinners".
/// This is the grouping a cook puts whole recipes into, and it is what the
/// "More in this group" section on a published recipe reads from. Not to be
/// confused with IngredientGroup and InstructionGroup, which are sections
/// inside a single recipe.
model Group {
  id        String   @id @default(cuid())
  blogId    String
  name      String
  /// Derived from the name, unique per blog, so re-typing a name joins the
  /// existing group instead of creating a near-duplicate.
  slug      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blog    Blog            @relation(fields: [blogId], references: [id], onDelete: Cascade)
  recipes GroupedRecipe[]

  @@unique([blogId, slug])
  @@index([blogId, name])
  @@map("groups")
}

/// Join table between recipes and groups. A recipe may sit in several groups.
model GroupedRecipe {
  id        String   @id @default(cuid())
  groupId   String
  recipeId  String
  createdAt DateTime @default(now())

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([groupId, recipeId])
  @@index([recipeId])
  @@map("grouped_recipes")
}

/// A titled section of ingredients, e.g. "For the chicken".
model IngredientGroup {
  id       String  @id @default(cuid())
  recipeId String
  title    String?
  position Int

  recipe      Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]

  @@index([recipeId, position])
  @@map("ingredient_groups")
}

model Ingredient {
  id       String @id @default(cuid())
  groupId  String
  text     String
  position Int

  group IngredientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, position])
  @@map("ingredients")
}

/// A titled section of instructions, e.g. "Prepare the chicken".
model InstructionGroup {
  id       String  @id @default(cuid())
  recipeId String
  title    String?
  position Int

  recipe Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  steps  InstructionStep[]

  @@index([recipeId, position])
  @@map("instruction_groups")
}

model InstructionStep {
  id       String  @id @default(cuid())
  groupId  String
  text     String
  imageUrl String?
  position Int

  group InstructionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, position])
  @@map("instruction_steps")
}
